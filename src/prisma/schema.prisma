generator client {
  provider = "prisma-client"
  output = "../generated/client"
}

datasource db {
  provider = "postgres"
}


model Owner {
  ownerId    Int      @id @default(autoincrement())
  fullName   String
  phone      String   @unique
  cnic       String?  @unique
  email      String?  @unique
  address    String?
  ntn        String?  // National Tax Number
  strn    String?  // Sales Tax Registration Number
  
  createdAt  DateTime @default(now())

  stores     ColdStore[]
}


model ColdStore {
  storeId    Int      @id @default(autoincrement())
  storeName  String
  city       String?
  address    String?
  phone      String?
  ownerId    Int
  createdAt  DateTime @default(now())

  owner      Owner    @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  floors      Floor[]
  ratePlans  RatePlan[]
  employees  Employee[]
  
}

model Floor {
  floorId        Int      @id @default(autoincrement())
  storeId        Int
  floorName      String
  temperatureMin Float?
  temperatureMax Float?
  isActive       Boolean  @default(true)

  store          ColdStore @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  racks          Rack[]
}

model Rack {
  rackId      Int      @id @default(autoincrement())
  floorId     Int
  rackName    String
  capacity    Int?
  floor       Floor    @relation(fields: [floorId], references: [floorId], onDelete: Cascade)
 }

model Farmer {
  farmerId   Int      @id @default(autoincrement())
  fullName   String
  phone      String   @unique
  cnic       String?  @unique
  address    String?
  marka      String?  // For identifying farmer's product
  createdAt  DateTime @default(now())

  contracts  StorageContract[]
  
  
}

model Item {
  itemId      Int     @id @default(autoincrement())
  itemName    String
  description String?

  ratePlans   RatePlan[]
  contractLines ContractLine[]
}

model RatePlan {
  rateId        Int      @id @default(autoincrement())
  storeId       Int
  itemId        Int?
  packagingType PackagingType?
  rateType      RateType
  rateAmount    Float
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())

  store         ColdStore    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  item          Item?        @relation(fields: [itemId], references: [itemId], onDelete: SetNull)
  }

model StorageContract {
  contractId      Int      @id @default(autoincrement())
  farmerId        Int
  contractCode    String   @unique
  startDate       DateTime
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  status          ContractStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime @default(now())

  farmer          Farmer        @relation(fields: [farmerId], references: [farmerId], onDelete: Cascade)
  items           ContractLine[]
  invoices        Invoice[]
  logs            ContractLog[]

  @@index([farmerId])
  
  }

model ContractLine {
  contractLineId   Int      @id @default(autoincrement())
  contractId       Int
  itemId           Int?
  packagingType    PackagingType?
  quantity         Int?
  unitRate         Float    @default(0)
  lateCharges      Float    @default(0) // Charges for late pickup or storage beyond expected end date
  remarks          String?

  item            Item?    @relation(fields: [itemId], references: [itemId], onDelete: SetNull)
  contract         StorageContract @relation(fields: [contractId], references: [contractId], onDelete: Cascade)
  movements        StockMovement[]
}

model StockMovement {
  movementId      Int      @id @default(autoincrement())
  contractLineId  Int?
  movementType    MovementType
  rackId          Int?
  quantity        Int      @default(0)
  movementDate    DateTime @default(now())
  referenceNote   String?

  contractLine    ContractLine?   @relation(fields: [contractLineId], references: [contractLineId], onDelete: SetNull)

  @@index([contractLineId])
}

model Invoice {
  invoiceId     Int       @id @default(autoincrement())
  contractId    Int
  invoiceNumber String    @unique
  invoiceDate   DateTime  @default(now())
  qrCode        String?   // For digital payments
  dueDate       DateTime?
  totalAmount   Float     @default(0) // Before tax
  salesTaxRate  Float     @default(0) // e.g., 16%
  salesTaxAmount Float    @default(0) // Calculated: totalAmount * salesTaxRate/100

  discount      Float     @default(0)
  netAmount     Float     @default(0)  // totalAmount + salesTaxAmount – discount

  status        InvoiceStatus @default(UNPAID)
  createdAt     DateTime  @default(now())

  contract      StorageContract @relation(fields: [contractId], references: [contractId], onDelete: Cascade)
  lines         InvoiceLine[]
  payments      Payment[]
}

model InvoiceLine {
  invoiceLineId Int      @id @default(autoincrement())
  invoiceId     Int
  itemId        Int?
  packagingType PackagingType?
  quantity      Float    @default(1)
  unitRate      Float    @default(0)
  description   String

  invoice       Invoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
}

model Payment {
  paymentId       Int      @id @default(autoincrement())
  invoiceId       Int
  paymentDate     DateTime @default(now())
  amount          Float
  paymentMethod   PaymentMethod
  transactionRef  String?
  remarks         String?

  invoice         Invoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  
  @@index([invoiceId])
  }

model Employee {
  employeeId  Int      @id @default(autoincrement())
  storeId     Int?
  fullName    String
  phone       String?  @unique
  role        String?
  salary      Float?
  hiredDate   DateTime?
  createdAt   DateTime @default(now())

  store       ColdStore? @relation(fields: [storeId], references: [storeId], onDelete: SetNull)
}

model ContractLog {
  logId       Int      @id @default(autoincrement())
  contractId  Int
  action      String
  actionTime  DateTime @default(now())
  performedBy String?
  notes       String?

  contract    StorageContract @relation(fields: [contractId], references: [contractId], onDelete: Cascade)
}

enum RateType {
  PER_BORI
  PER_TORA
  PER_CRATE
  PER_DAY
  PER_MONTH
  FIXED
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PackagingType {
  BORI
  TORA
  CRATE
}

enum MovementType {
  IN
  OUT
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  BANK
  EASYPaisa
  JAZZCASH
  CHEQUE
}


