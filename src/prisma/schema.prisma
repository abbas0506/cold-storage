generator client {
  provider = "prisma-client"
  output = "../generated/client"
}

datasource db {
  provider = "postgres"
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

model User{
  id        Int @id @default(autoincrement())
  username  String @unique
  password  String
  lastLogin DateTime?
  fcmToken  String?
  role UserRole @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings{
  id      Int @id @default(autoincrement())
  key     String
  value   String
}

model Room {
  id              Int      @id @default(autoincrement())
  roomName        String
  capacity        Int?
  temperatureMin  Float?
  temperatureMax  Float?
  isActive        Boolean  @default(true)

  floors          floor[]
}

model floor {
  id              Int      @id @default(autoincrement())
  floorName       String
  description     String?
  roomId          Int

  racks           Rack[]
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Rack {
  id          Int      @id @default(autoincrement())
  floorId     Int
  rackName    String   //will be derive from floor and row + Left/Right
    
  floor       floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
}

model Farmer {
  id         Int      @id @default(autoincrement())
  fullName   String
  phone      String   @unique
  cnic       String?  @unique
  address    String?
  marka      String?  // For identifying farmer's product
  createdAt  DateTime @default(now())

  contracts  StorageContract[]
 
}

model Item {
  id          Int     @id @default(autoincrement())
  itemName    String
  description String?

  ratePlans   RatePlan[]
  contractLines ContractLine[]
}

model RatePlan {
  id            Int      @id @default(autoincrement())
  itemId        Int?
  packagingType PackagingType?
  rateType      RateType
  rateAmount    Float
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())

  item          Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  }

model StorageContract {
  id              Int      @id @default(autoincrement())
  farmerId        Int
  contractCode    String   @unique
  startDate       DateTime
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  status          ContractStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime @default(now())

  farmer          Farmer        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  items           ContractLine[]
  invoices        Invoice[]
  logs            ContractLog[]

  @@index([farmerId])
  
  }

model ContractLine {
  id               Int      @id @default(autoincrement())
  contractId       Int
  itemId           Int?
  packagingType    PackagingType?
  quantity         Int?
  unitRate         Float    @default(0)
  lateCharges      Float    @default(0) // Charges for late pickup or storage beyond expected end date
  remarks          String?

  item             Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  contract         StorageContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  movements        StockMovement[]
}

model StockMovement {
  id              Int      @id @default(autoincrement())
  contractLineId  Int?
  movementType    MovementType
  rackId          Int?
  quantity        Int      @default(0)
  movementDate    DateTime @default(now())
  referenceNote   String?

  contractLine    ContractLine?   @relation(fields: [contractLineId], references: [id], onDelete: SetNull)

  @@index([contractLineId])
}

model Invoice {
  id            Int       @id @default(autoincrement())
  contractId    Int
  invoiceDate   DateTime  @default(now())
  fbrInvoiceCode        String?   // For digital payments
  fbrQrCode        String?   // For digital payments
  praInvoiceCode        String?   // For digital payments
  praQrCode        String?   // For digital payments
  dueDate       DateTime?
  totalAmount   Float     @default(0) // Before tax
  salesTaxRate  Float     @default(0) // e.g., 16%
  salesTaxAmount Float    @default(0) // Calculated: totalAmount * salesTaxRate/100

  discount      Float     @default(0)
  netAmount     Float     @default(0)  // totalAmount + salesTaxAmount – discount

  status        InvoiceStatus @default(UNPAID)
  createdAt     DateTime  @default(now())

  contract      StorageContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  lines         InvoiceLine[]
  payments      Payment[]
}

model InvoiceLine {
  id            Int        @id @default(autoincrement())
  invoiceId     Int
  itemId        Int?
  packagingType PackagingType?
  quantity      Float    @default(1)
  unitRate      Float    @default(0)
  description   String

  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id            Int      @id @default(autoincrement())
  invoiceId       Int
  paymentDate     DateTime @default(now())
  amount          Float
  paymentMethod   PaymentMethod
  transactionRef  String?
  remarks         String?

  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  @@index([invoiceId])
  }

model ContractLog {
  id          Int      @id @default(autoincrement())
  contractId  Int
  action      String
  actionTime  DateTime @default(now())
  performedBy String?
  notes       String?

  contract    StorageContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

enum RateType {
  PER_DAY
  PER_MONTH
  FIXED
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PackagingType {
  BORI
  TORA
  CRATE
}

enum MovementType {
  IN
  OUT
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  BANK
  EASYPaisa
  JAZZCASH
  CHEQUE
}


