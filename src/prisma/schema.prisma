generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgres"
}

// ─── System-level role (platform-wide) ────────────────────────────────────────
enum SystemRole {
  SUPER_ADMIN // Platform owner – manages plans & subscriptions
  SUBSCRIBER // Business owner – buys a plan, owns cold stores
  USER // Store-level staff – assigned to stores by subscriber
}

// ─── Store-level role (per cold-store) ────────────────────────────────────────
enum StoreRole {
  ADMIN
  EMPLOYEE
}

// ─── Subscription lifecycle ───────────────────────────────────────────────────
enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

// ─── Users ────────────────────────────────────────────────────────────────────
model User {
  id          Int        @id @default(autoincrement())
  username    String     @unique
  password    String
  name        String?
  phone       String?
  email       String?    @unique
  lastLogin   DateTime?
  fcmToken    String?
  systemRole  SystemRole @default(USER)
  isActive    Boolean    @default(true)
  /// Who created this user (subscriber creates store users)
  createdById Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy    User?         @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]        @relation("UserCreatedBy")
  subscription Subscription?
  storeAccess  StoreUser[]
}

model Settings {
  id    Int    @id @default(autoincrement())
  key   String
  value String
}

// ─── Subscription plans (managed by SUPER_ADMIN) ──────────────────────────────
model SubscriptionPlan {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  description      String?
  pricePerMonth    Float
  maxStores        Int      @default(1)
  maxUsersPerStore Int      @default(5)
  durationDays     Int      @default(30)
  features         Json?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

// ─── Subscriptions (SUPER_ADMIN assigns to SUBSCRIBER users) ──────────────────
model Subscription {
  id        Int                @id @default(autoincrement())
  userId    Int                @unique
  planId    Int
  status    SubscriptionStatus @default(PENDING)
  startDate DateTime
  endDate   DateTime
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])
  coldStores ColdStore[]

  @@map("subscriptions")
}

// ─── Cold stores ──────────────────────────────────────────────────────────────
model ColdStore {
  id             Int      @id @default(autoincrement())
  name           String
  hashCode       String
  address        String?
  phone          String?
  subscriptionId Int?
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  storeUsers   StoreUser[]
  rooms        Room[]
  ratePlans    RatePlan[]
  farmers      Farmer[]
  items        Item[]
  expenses     Expense[]
  employees    Employee[]

  @@map("cold_stores")
}

// ─── Store-user membership (store-level roles) ────────────────────────────────
model StoreUser {
  id        Int       @id @default(autoincrement())
  storeId   Int
  userId    Int
  role      StoreRole @default(EMPLOYEE)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store ColdStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@map("store_users")
}

model Room {
  id           Int     @id @default(autoincrement())
  name         String
  tempMin      Float?
  tempMax      Float?
  numOfFloors  Int     @default(0)
  numOfRacks   Int     @default(0)
  roomCapacity Int     @default(0)
  isActive     Boolean @default(true)
  storeId      Int

  store ColdStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  racks Rack[]
}

model Rack {
  id           Int    @id @default(autoincrement())
  name         String //will be derive from floor and row + Left/Right
  capacity     Int?
  currentStock Int    @default(0)
  roomId       Int

  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
}

model Farmer {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String
  cnic      String?
  address   String?
  marka     String? // For identifying farmer's product
  storeId   Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  contracts Contract[]
  ledgers   Ledger[]
  payments  Payment[]
  store     ColdStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, cnic])
}

model Item {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  storeId       Int
  contractLines ContractLine[]
  store         ColdStore      @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model RatePlan {
  id            Int            @id @default(autoincrement())
  packagingType PackagingType?
  rateType      RateType?
  rateAmount    Float
  storeId       Int
  store         ColdStore      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("rate_plans")
}

model Contract {
  id               Int            @id @default(autoincrement())
  farmerId         Int
  contractCode     String         @unique
  startDate        DateTime
  expectedEndDate  DateTime?
  actualEndDate    DateTime?
  saleTaxRate      Float          @default(0) // e.g., 16%
  totalAmount      Float          @default(0) // Before tax
  salesTaxAmount   Float          @default(0) // Calculated: totalAmount * salesTaxRate/100
  netAmount        Float          @default(0) // totalAmount + salesTaxAmount – discount
  status           ContractStatus @default(ACTIVE)
  notes            String?
  fbrInvoiceNumber String?        @unique
  praInvoiceNumber String?        @unique
  ledgerId         Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  farmer Farmer         @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  items  ContractLine[]

  @@index([farmerId])
  @@map("storage_contracts")
}

model ContractLine {
  id            Int            @id @default(autoincrement())
  contractId    Int
  itemId        Int?
  packagingType PackagingType?
  quantity      Int?
  unitRate      Float          @default(0)
  lateCharges   Float          @default(0) // Charges for late pickup or storage beyond expected end date
  remarks       String?

  item      Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)
  contract  Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  movements StockMovement[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("contract_lines")
}

model StockMovement {
  id             Int          @id @default(autoincrement())
  contractLineId Int?
  movementType   MovementType
  rackId         Int?
  quantity       Int          @default(0)
  movementDate   DateTime     @default(now())
  referenceNote  String?

  contractLine ContractLine? @relation(fields: [contractLineId], references: [id], onDelete: SetNull)
  rack         Rack?         @relation(fields: [rackId], references: [id], onDelete: SetNull)

  @@index([contractLineId])
  @@map("stock_movements")
}

model Payment {
  id             Int           @id @default(autoincrement())
  paymentDate    DateTime      @default(now())
  amount         Float
  paymentMethod  PaymentMethod
  transactionRef String?
  remarks        String?
  ledgerId       Int?
  farmerId       Int
  farmer         Farmer        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Ledger {
  id              Int      @id @default(autoincrement())
  farmerId        Int
  transactionDate DateTime @default(now())
  description     String
  debit           Float // Amount added to the invoice (e.g., new charges)
  credit          Float // Amount paid towards the invoice
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  farmer          Farmer   @relation(fields: [farmerId], references: [id])
}

enum RateType {
  PER_DAY
  PER_MONTH
  FIXED
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PackagingType {
  BORI
  TORA
  CRATE
}

enum MovementType {
  IN
  OUT
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  BANK
  EASYPaisa
  JAZZCASH
  CHEQUE
}

model ExpenseType {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(50)
  expenses Expense[]
}

model Expense {
  id            Int           @id @default(autoincrement())
  storeId       Int
  amount        Float
  expenseTypeId Int
  paymentMethod PaymentMethod
  description   String
  expenseDate   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store       ColdStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  expenseType ExpenseType @relation(fields: [expenseTypeId], references: [id])
}

model Employee {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String
  storeId      Int
  joiningDate  DateTime
  designation  String? // e.g., "Cashier", "Store Manager"
  baseSalary   Float // Agreed monthly salary
  advanceLimit Float    @default(0) // Max total advance allowed at once (0 = no limit)
  balance      Float    @default(0) // Denormalized. Positive = company owes employee, Negative = employee owes company
  active       Boolean  @default(true)

  ledger      EmployeeLedger[]
  salarySlips SalarySlip[]
  store       ColdStore        @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

// ------------------------------------------------------------------
// Every financial event that affects an employee's balance.
// This is the single source of truth — never update Employee.balance
// directly; always write a ledger entry and update balance atomically
// inside a Prisma $transaction.
// ------------------------------------------------------------------
model EmployeeLedger {
  id         Int      @id @default(autoincrement())
  employeeId Int
  debit      Float    @default(0) // Amount added to employee's balance (e.g., salary credit, advance reversal)
  credit     Float    @default(0) // Amount deducted from employee's balance (e.g., advance taken, salary deduction)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, createdAt])
  @@map("employee_ledger")
}

model SalarySlip {
  id              Int          @id @default(autoincrement())
  employeeId      Int
  year            Int
  month           Int // 1–12
  baseSalary      Float // Snapshot of Employee.baseSalary at time of generation
  bonus           Float        @default(0)
  totalAdvances   Float        @default(0) // Sum of all PENDING advances deducted this month
  otherDeductions Float        @default(0) // Credit purchases, fines, penalties — entered manually
  netPayable      Float // baseSalary + bonus - totalAdvances - otherDeductions
  status          SalaryStatus @default(DRAFT)
  paidDate        DateTime?
  note            String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year, month]) // One slip per employee per month
  @@map("salary_slips")
}

enum SalaryStatus {
  DRAFT // Generated but not yet reviewed
  APPROVED // Reviewed and approved, ready to pay
  PAID // Net salary has been disbursed
  CANCELLED // Voided (e.g., employee left mid-month)
}
