generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgres"
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  lastLogin DateTime?
  fcmToken  String?
  role      UserRole  @default(EMPLOYEE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  coldStores ColdStore[]
}

model Settings {
  id    Int    @id @default(autoincrement())
  key   String
  value String
}

model ColdStore {
  id       Int     @id @default(autoincrement())
  name     String
  hashCode String
  address  String?
  phone    String?
  userId   Int

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rooms     Room[]
  ratePlans RatePlan[]
  farmers   Farmer[]
  items     Item[]

  @@map("cold_stores")
}

model Room {
  id           Int     @id @default(autoincrement())
  name         String
  tempMin      Float?
  tempMax      Float?
  numOfFloors  Int     @default(0)
  numOfRacks   Int     @default(0)
  roomCapacity Int     @default(0)
  isActive     Boolean @default(true)
  storeId      Int

  store ColdStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  racks Rack[]
}

model Rack {
  id           Int    @id @default(autoincrement())
  name         String //will be derive from floor and row + Left/Right
  capacity     Int?
  currentStock Int    @default(0)
  roomId       Int

  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
}

model Farmer {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String
  cnic      String?
  address   String?
  marka     String? // For identifying farmer's product
  storeId   Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  contracts Contract[]
  ledgers   Ledger[]
  payments  Payment[]
  store     ColdStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, cnic])
}

model Item {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  storeId       Int
  contractLines ContractLine[]
  store         ColdStore      @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model RatePlan {
  id            Int            @id @default(autoincrement())
  packagingType PackagingType?
  rateType      RateType?
  rateAmount    Float
  storeId       Int
  store         ColdStore      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("rate_plans")
}

model Contract {
  id               Int            @id @default(autoincrement())
  farmerId         Int
  contractCode     String         @unique
  startDate        DateTime
  expectedEndDate  DateTime?
  actualEndDate    DateTime?
  saleTaxRate      Float          @default(0) // e.g., 16%
  totalAmount      Float          @default(0) // Before tax
  salesTaxAmount   Float          @default(0) // Calculated: totalAmount * salesTaxRate/100
  netAmount        Float          @default(0) // totalAmount + salesTaxAmount – discount
  status           ContractStatus @default(ACTIVE)
  notes            String?
  fbrInvoiceNumber String?        @unique
  praInvoiceNumber String?        @unique
  ledgerId         Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  farmer Farmer         @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  items  ContractLine[]

  @@index([farmerId])
  @@map("storage_contracts")
}

model ContractLine {
  id            Int            @id @default(autoincrement())
  contractId    Int
  itemId        Int?
  packagingType PackagingType?
  quantity      Int?
  unitRate      Float          @default(0)
  lateCharges   Float          @default(0) // Charges for late pickup or storage beyond expected end date
  remarks       String?

  item      Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)
  contract  Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  movements StockMovement[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("contract_lines")
}

model StockMovement {
  id             Int          @id @default(autoincrement())
  contractLineId Int?
  movementType   MovementType
  rackId         Int?
  quantity       Int          @default(0)
  movementDate   DateTime     @default(now())
  referenceNote  String?

  contractLine ContractLine? @relation(fields: [contractLineId], references: [id], onDelete: SetNull)
  rack         Rack?         @relation(fields: [rackId], references: [id], onDelete: SetNull)

  @@index([contractLineId])
  @@map("stock_movements")
}

model Payment {
  id             Int           @id @default(autoincrement())
  paymentDate    DateTime      @default(now())
  amount         Float
  paymentMethod  PaymentMethod
  transactionRef String?
  remarks        String?
  ledgerId       Int?
  farmerId       Int
  farmer         Farmer        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Ledger {
  id              Int      @id @default(autoincrement())
  farmerId        Int
  transactionDate DateTime @default(now())
  description     String
  debit           Float // Amount added to the invoice (e.g., new charges)
  credit          Float // Amount paid towards the invoice
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  farmer          Farmer   @relation(fields: [farmerId], references: [id])
}

enum RateType {
  PER_DAY
  PER_MONTH
  FIXED
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PackagingType {
  BORI
  TORA
  CRATE
}

enum MovementType {
  IN
  OUT
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  BANK
  EASYPaisa
  JAZZCASH
  CHEQUE
}
